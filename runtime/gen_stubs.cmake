# Generates stubs.cpp: a logging stub for every import the game uses that the
# runtime doesn't implement yet. Run in script mode:
#   cmake -DPPC_DIR=... -DRUNTIME_DIR=... -DOUT=... -P gen_stubs.cmake

file(STRINGS "${PPC_DIR}/ppc_recomp_shared.h" decls REGEX "PPC_EXTERN_FUNC\\(__imp__")
set(imports "")
foreach(line IN LISTS decls)
    string(REGEX REPLACE ".*__imp__([A-Za-z0-9_]+).*" "\\1" name "${line}")
    list(APPEND imports "${name}")
endforeach()
list(REMOVE_DUPLICATES imports)

file(GLOB sources "${RUNTIME_DIR}/*.cpp")
set(implemented "")
foreach(src IN LISTS sources)
    file(STRINGS "${src}" lines REGEX "^IMPORT\\(")
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "^IMPORT\\(([A-Za-z0-9_]+)\\).*" "\\1" name "${line}")
        list(APPEND implemented "${name}")
    endforeach()
endforeach()

set(out "// Generated by gen_stubs.cmake. Imports the runtime doesn't implement yet.\n")
string(APPEND out "#include \"kernel.h\"\n\n")
string(APPEND out "static void Stub(const char* name, PPCContext& ctx)\n{\n")
string(APPEND out "    static std::mutex lock;\n    static std::unordered_map<std::string, uint32_t> counts;\n")
string(APPEND out "    uint32_t n;\n    { std::lock_guard g(lock); n = ++counts[name]; }\n")
string(APPEND out "    if (n <= 3 || (n & (n - 1)) == 0)\n")
string(APPEND out "        LOG_WARN(\"unimplemented {} (call #{}) r3=0x{:X} r4=0x{:X} r5=0x{:X}\", name, n, ctx.r3.u32, ctx.r4.u32, ctx.r5.u32);\n")
string(APPEND out "    ctx.r3.u64 = 0;\n}\n\n")

set(count 0)
foreach(name IN LISTS imports)
    list(FIND implemented "${name}" idx)
    if(idx EQUAL -1)
        string(APPEND out "PPC_FUNC(__imp__${name}) { Stub(\"${name}\", ctx); }\n")
        math(EXPR count "${count} + 1")
    endif()
endforeach()

list(LENGTH imports total)
string(APPEND out "\n// ${count} of ${total} imports are stubs\n")
file(WRITE "${OUT}.tmp" "${out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
message(STATUS "stubs: ${count} of ${total} imports not implemented yet")
